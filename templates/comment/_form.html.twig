{# Shared Comment form (Admin) #}
{% set cancel_route = cancel_route|default('admin_comment_index') %}
{% set cancel_params = cancel_params|default({}) %}

{{ form_start(form) }}
    {{ form_widget(form) }}

    <div class="d-grid d-sm-flex gap-2 mt-3">
        <button class="btn btn-dark">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path(cancel_route, cancel_params) }}" class="btn btn-outline-dark">Retour</a>
    </div>
{{ form_end(form) }}
