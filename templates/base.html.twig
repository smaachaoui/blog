<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Blog{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body class="bg-light text-dark d-flex flex-column min-vh-100">
        <header class="bg-dark text-white">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_home') }}">Blog Littéraire</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav ms-auto">
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="/">Admin</a>
                                </li>
                            {% endif %}

                            {% if app.user %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('dashboard_post_index') }}">Mes articles</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('category_index') }}">Catégories</a>
                                </li>
                            {% endif %}



                            {% if app.user %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main class="py-4 flex-grow-1">
            <div class="container">
                {% include 'partials/_flashes.html.twig' %}
                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="bg-dark text-white py-3 mt-auto">
            <div class="container text-center small">
                © {{ "now"|date("Y") }} Blog Littéraire
            </div>
        </footer>
    </body>
</html>
