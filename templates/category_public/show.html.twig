{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">{{ category.name }}</h1>
    <a class="btn btn-outline-dark btn-sm" href="{{ path('category_index') }}">Toutes les catégories</a>
</div>

<div class="row g-3">
    {% for post in posts %}
        <div class="col-12 col-md-6">
            <div class="card shadow-sm page-card h-100">
                <div class="card-body p-4">
                    {% if post.coverImage %}
                        <img src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                             alt="Couverture"
                             class="img-fluid rounded mb-3"
                             loading="lazy">
                    {% endif %}

                    <h2 class="h5 mb-1">
                        <a class="text-decoration-none text-dark" href="{{ path('blog_show', {slug: post.slug}) }}">
                            {{ post.title }}
                        </a>
                    </h2>

                    <div class="text-muted small">
                        {{ post.bookAuthor }} · {{ post.createdAt|date('d/m/Y') }}
                    </div>

                    <div class="mt-3">
                        <a href="{{ path('blog_show', {slug: post.slug}) }}" class="btn btn-outline-dark btn-sm">
                            Lire
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-muted">Aucun article dans cette catégorie.</div>
        </div>
    {% endfor %}
</div>

{% if totalPages > 1 %}
<nav class="mt-4" aria-label="Pagination">
    <ul class="pagination justify-content-center mb-0">
        <li class="page-item {{ currentPage <= 1 ? 'disabled' }}">
            <a class="page-link text-dark"
               href="{{ path('category_show', {slug: category.slug, page: currentPage - 1}) }}">
                Précédent
            </a>
        </li>

        {% for p in 1..totalPages %}
            <li class="page-item {{ p == currentPage ? 'active' }}">
                <a class="page-link {{ p == currentPage ? 'text-white bg-dark border-dark' : 'text-dark' }}"
                   href="{{ path('category_show', {slug: category.slug, page: p}) }}">
                    {{ p }}
                </a>
            </li>
        {% endfor %}

        <li class="page-item {{ currentPage >= totalPages ? 'disabled' }}">
            <a class="page-link text-dark"
               href="{{ path('category_show', {slug: category.slug, page: currentPage + 1}) }}">
                Suivant
            </a>
        </li>
    </ul>
</nav>
{% endif %}
{% endblock %}
