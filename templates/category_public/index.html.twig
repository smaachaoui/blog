{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Catégories</h1>
</div>

<div class="row g-3">
    {% for category in categories %}
        <div class="col-12 col-md-4">
            <a href="{{ path('category_show', {slug: category.slug}) }}" class="text-decoration-none">
                <div class="card shadow-sm page-card h-100">
                    <div class="card-body p-4">
                        <div class="h6 text-dark mb-0">{{ category.name }}</div>
                        <div class="text-muted small mt-1">Voir les articles</div>
                    </div>
                </div>
            </a>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-muted">Aucune catégorie.</div>
        </div>
    {% endfor %}
</div>
{% endblock %}
