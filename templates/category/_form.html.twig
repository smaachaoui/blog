{# Shared Category form (Admin) #}
{% set cancel_route = cancel_route|default('admin_category_index') %}
{% set cancel_params = cancel_params|default({}) %}

{{ form_start(form) }}
    <div class="mb-3">
        {{ form_row(form.name) }}
    </div>

    {% if form.slug is defined %}
        <div class="mb-3">
            {{ form_row(form.slug) }}
            <div class="form-text">Laisse vide si le slug est généré automatiquement.</div>
        </div>
    {% endif %}

    <div class="d-grid d-sm-flex gap-2 mt-3">
        <button class="btn btn-dark">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path(cancel_route, cancel_params) }}" class="btn btn-outline-dark">Retour</a>
    </div>
{{ form_end(form) }}
