{# Shared Category delete form (Admin) #}
{% set delete_route = delete_route|default('admin_category_delete') %}
{% set delete_params = delete_params|default({id: category.id}) %}
{% set confirm_message = confirm_message|default("Supprimer définitivement cette catégorie ?") %}

<form method="post"
      action="{{ path(delete_route, delete_params) }}"
      onsubmit="return confirm('{{ confirm_message|e('js') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button class="btn btn-outline-danger w-100">Supprimer</button>
</form>
