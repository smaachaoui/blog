{# J'ai cree le template pour afficher une categorie admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ category.name }}{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: category.name,
    subtitle: 'Slug : ' ~ category.slug,
    back_route: 'admin_category_index',
    back_label: 'Retour à la liste',
    actions: '<a href="' ~ path('admin_category_edit', {id: category.id}) ~ '" class="btn btn-dark btn-sm">Modifier</a>'
} %}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">ID</dt>
                    <dd class="col-sm-9">#{{ category.id }}</dd>

                    <dt class="col-sm-3 text-muted">Nom</dt>
                    <dd class="col-sm-9">{{ category.name }}</dd>

                    <dt class="col-sm-3 text-muted">Slug</dt>
                    <dd class="col-sm-9"><code class="text-muted">{{ category.slug }}</code></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        {% include 'components/_danger_zone.html.twig' with {
            delete_route: 'admin_category_delete',
            delete_params: {id: category.id},
            entity_id: category.id,
            confirm_message: 'Supprimer cette catégorie ?'
        } %}
    </div>
</div>
{% endblock %}
