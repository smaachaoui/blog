{# J'ai cree la liste des categories admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Catégories{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: 'Catégories',
    subtitle: 'Gestion des catégories du blog.',
    actions: '<a href="' ~ path('admin_category_new') ~ '" class="btn btn-dark btn-sm">Nouvelle catégorie</a>'
} %}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th class="d-none d-md-table-cell">Slug</th>
                    <th class="text-end" style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr>
                    <td class="fw-semibold">{{ category.name }}</td>
                    <td class="d-none d-md-table-cell">
                        <code class="text-muted">{{ category.slug }}</code>
                    </td>
                    <td class="text-end">
                        <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-outline-dark btn-sm">
                            Modifier
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">
                        {% include 'components/_empty_state.html.twig' with {message: 'Aucune catégorie.'} %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
