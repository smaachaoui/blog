<div class="card shadow-sm overflow-hidden">
    <div class="card-body p-3 bg-dark text-white">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <div>
                <div class="fw-semibold">Menu du chef</div>
                <div class="small text-white-50">Le centre de commande</div>
            </div>

            <button class="btn btn-outline-light btn-sm d-md-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminMenu"
                    aria-expanded="false"
                    aria-controls="adminMenu">
                Menu
            </button>
        </div>
    </div>

    <div id="adminMenu" class="collapse d-md-block">
        <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}"
               href="{{ path('admin_dashboard') }}">
                Tableau de bord
            </a>

            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'admin_user_' ? 'active' : '' }}"
               href="{{ path('admin_user_index') }}">
                Utilisateurs
            </a>

            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'admin_post_' ? 'active' : '' }}"
               href="{{ path('admin_post_index') }}">
                Articles
            </a>

            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'admin_category_' ? 'active' : '' }}"
               href="{{ path('admin_category_index') }}">
                Catégories
            </a>

            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'admin_comment_' ? 'active' : '' }}"
               href="{{ path('admin_comment_index') }}">
                Commentaires
            </a>

            <div class="list-group-item d-flex flex-column gap-2">
                <a href="{{ path('app_home') }}" class="text-decoration-none">
                    Retour au site
                </a>

                <a href="{{ path('app_logout') }}" class="text-decoration-none text-danger">
                    Déconnexion
                </a>
            </div>
        </div>
    </div>
</div>
