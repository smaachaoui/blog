{# J'ai cree le template pour afficher un commentaire admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Commentaire #{{ comment.id }}{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: 'Commentaire #' ~ comment.id,
    subtitle: comment.authorName ~ ' — ' ~ comment.createdAt|date('d/m/Y H:i'),
    back_route: 'admin_comment_index',
    back_label: 'Retour à la liste',
    actions: '<a href="' ~ path('admin_comment_edit', {id: comment.id}) ~ '" class="btn btn-dark btn-sm">Modifier</a>'
} %}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <dl class="row mb-4">
                    <dt class="col-sm-3 text-muted">Auteur</dt>
                    <dd class="col-sm-9">{{ comment.authorName }}</dd>

                    <dt class="col-sm-3 text-muted">Email</dt>
                    <dd class="col-sm-9">{{ comment.authorEmail }}</dd>

                    <dt class="col-sm-3 text-muted">Article</dt>
                    <dd class="col-sm-9">{{ comment.post ? comment.post.title : '—' }}</dd>

                    <dt class="col-sm-3 text-muted">Statut</dt>
                    <dd class="col-sm-9">
                        {% if comment.isApproved %}
                            <span class="badge bg-success">Approuvé</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">En attente</span>
                        {% endif %}
                    </dd>

                    <dt class="col-sm-3 text-muted">Date</dt>
                    <dd class="col-sm-9">{{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '—' }}</dd>
                </dl>

                <hr>

                <h2 class="h6 mb-3">Contenu</h2>
                <div class="text-dark">{{ comment.content|nl2br }}</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        {% include 'components/_danger_zone.html.twig' with {
            delete_route: 'admin_comment_delete',
            delete_params: {id: comment.id},
            entity_id: comment.id,
            confirm_message: 'Supprimer ce commentaire ?'
        } %}
    </div>
</div>
{% endblock %}
