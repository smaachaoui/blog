{# J'ai cree le template de base pour les formulaires commentaire admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ page_title|default('Commentaire') }}{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: heading|default(page_title|default('Commentaire')),
    subtitle: subtitle|default('Modifier le commentaire.'),
    back_route: 'admin_comment_index',
    back_label: 'Retour à la liste'
} %}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                {% include 'form/_comment.html.twig' with {
                    form: form,
                    button_label: button_label|default('Enregistrer'),
                    cancel_route: 'admin_comment_index'
                } %}
            </div>
        </div>
    </div>

    {% if show_delete|default(false) and comment is defined %}
        <div class="col-12 col-lg-4">
            {% include 'components/_danger_zone.html.twig' with {
                delete_route: 'admin_comment_delete',
                delete_params: {id: comment.id},
                entity_id: comment.id,
                confirm_message: 'Supprimer ce commentaire ?'
            } %}
        </div>
    {% endif %}
</div>
{% endblock %}
