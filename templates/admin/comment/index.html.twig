{% extends 'admin/base.html.twig' %}

{% block title %}Commentaires{% endblock %}

{% block admin_content %}
<div class="card shadow-sm page-card">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Commentaires</h1>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-dark btn-sm" href="{{ path('admin_comment_index') }}">Tous</a>
                <a class="btn btn-dark btn-sm" href="{{ path('admin_comment_index', {pending: 1}) }}">En attente</a>
            </div>
        </div>

        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Auteur</th>
                    <th>Article</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for comment in comments %}
                <tr>
                    <td>{{ comment.authorName }}</td>
                    <td>{{ comment.post.title }}</td>
                    <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if comment.isApproved %}
                            <span class="badge bg-dark">Approuvé</span>
                        {% else %}
                            <span class="badge bg-secondary">En attente</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        {% if not comment.isApproved %}
                            <form method="post" action="{{ path('admin_comment_approve', {id: comment.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ comment.id) }}">
                                <button class="btn btn-sm btn-outline-dark">Approuver</button>
                            </form>
                        {% endif %}

                        <form method="post" action="{{ path('admin_comment_delete', {id: comment.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                            <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">Aucun commentaire</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
