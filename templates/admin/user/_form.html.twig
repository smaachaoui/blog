{{ form_start(form) }}

<div class="mb-3">
    {{ form_row(form.email) }}
</div>

<div class="mb-3">
    {{ form_row(form.roles) }}
</div>

<hr>

<h2 class="h6 mb-2">Sécurité</h2>

<div class="mb-3">
    {{ form_row(form.plainPassword.first) }}
</div>

<div class="mb-3">
    {{ form_row(form.plainPassword.second) }}
</div>

<button class="btn btn-dark">
    {{ button_label|default('Enregistrer') }}
</button>

{{ form_end(form) }}
