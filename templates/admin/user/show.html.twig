{# J'ai cree le template pour afficher un utilisateur admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ user.email }}{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: 'Détails utilisateur',
    subtitle: user.email,
    back_route: 'admin_user_index',
    back_label: 'Retour à la liste',
    actions: '<a href="' ~ path('admin_user_edit', {id: user.id}) ~ '" class="btn btn-dark btn-sm">Modifier</a>'
} %}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">ID</dt>
                    <dd class="col-sm-9">{{ user.id }}</dd>

                    <dt class="col-sm-3 text-muted">Email</dt>
                    <dd class="col-sm-9">{{ user.email }}</dd>

                    <dt class="col-sm-3 text-muted">Rôles</dt>
                    <dd class="col-sm-9">
                        {% for role in user.roles %}
                            {% set label = role|replace({'ROLE_':'', '_':' '})|lower|title %}
                            <span class="badge bg-dark">{{ label }}</span>
                        {% else %}
                            <span class="text-muted">Aucun</span>
                        {% endfor %}
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        {% include 'components/_danger_zone.html.twig' with {
            delete_route: 'admin_user_delete',
            delete_params: {id: user.id},
            entity_id: user.id,
            confirm_message: 'Supprimer cet utilisateur ?'
        } %}
    </div>
</div>
{% endblock %}
