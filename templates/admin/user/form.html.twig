{% extends 'admin/base.html.twig' %}

{% block title %}{{ page_title|default('Utilisateur') }}{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">{{ heading|default(page_title|default('Utilisateur')) }}</h1>
        <p class="text-muted mb-0">{{ subtitle|default('Créer ou modifier un compte et définir ses rôles.') }}</p>
    </div>

    <a class="btn btn-outline-dark btn-sm" href="{{ path('admin_user_index') }}">
        Retour à la liste
    </a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ include('user/_form.html.twig', {
                    form: form,
                    button_label: button_label|default('Enregistrer'),
                    cancel_route: 'admin_user_index'
                }) }}
            </div>
        </div>
    </div>

    {% if show_delete|default(false) %}
        <div class="col-12 col-lg-4">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h6 text-danger mb-2">Zone dangereuse</h2>
                    <p class="text-muted small mb-3">La suppression est définitive.</p>

                    {{ include('user/_delete_form.html.twig', { user: user }) }}
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
