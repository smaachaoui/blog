{# J'ai cree le template de base pour les formulaires utilisateur admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ page_title|default('Utilisateur') }}{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: heading|default(page_title|default('Utilisateur')),
    subtitle: subtitle|default('Gérer le compte et les rôles.'),
    back_route: 'admin_user_index',
    back_label: 'Retour à la liste'
} %}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                {% include 'form/_user.html.twig' with {
                    form: form,
                    button_label: button_label|default('Enregistrer'),
                    cancel_route: 'admin_user_index'
                } %}
            </div>
        </div>
    </div>

    {% if show_delete|default(false) and user is defined %}
        <div class="col-12 col-lg-4">
            {% include 'components/_danger_zone.html.twig' with {
                delete_route: 'admin_user_delete',
                delete_params: {id: user.id},
                entity_id: user.id,
                confirm_message: 'Supprimer cet utilisateur ?'
            } %}
        </div>
    {% endif %}
</div>
{% endblock %}
