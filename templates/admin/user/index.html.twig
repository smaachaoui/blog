{% extends 'admin/base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block admin_content %}
<div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Utilisateurs</h1>
        <div class="text-muted small">Gestion des comptes et des rôles.</div>
    </div>

    <a class="btn btn-dark btn-sm" href="{{ path('admin_user_new') }}">
        Nouvel utilisateur
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">ID</th>
                        <th>Email</th>
                        <th style="width: 220px;">Rôles</th>
                        <th class="text-end" style="width: 200px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="text-muted">{{ user.id }}</td>

                        <td class="fw-semibold text-break">
                            {{ user.email }}
                        </td>

                        <td>
                            {% if user.roles is empty %}
                                <span class="badge text-bg-secondary">Aucun</span>
                            {% else %}
                                {% for role in user.roles %}
                                    {% set label = role|replace({'ROLE_':'', '_':' '})|lower|title %}
                                    <span class="badge text-bg-dark">{{ label }}</span>
                                {% endfor %}
                            {% endif %}
                        </td>

                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a class="btn btn-outline-dark btn-sm"
                                   href="{{ path('admin_user_show', {'id': user.id}) }}">
                                    Voir
                                </a>

                                <a class="btn btn-outline-dark btn-sm"
                                   href="{{ path('admin_user_edit', {'id': user.id}) }}">
                                    Modifier
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            Aucun utilisateur trouvé.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
