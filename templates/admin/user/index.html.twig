{# J'ai cree la liste des utilisateurs admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Utilisateurs{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: 'Utilisateurs',
    subtitle: 'Gestion des comptes et des rôles.',
    actions: '<a href="' ~ path('admin_user_new') ~ '" class="btn btn-dark btn-sm">Nouvel utilisateur</a>'
} %}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Email</th>
                    <th class="d-none d-md-table-cell" style="width: 200px;">Rôles</th>
                    <th class="text-end" style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td class="text-muted">{{ user.id }}</td>
                    <td class="fw-semibold text-break">{{ user.email }}</td>
                    <td class="d-none d-md-table-cell">
                        {% for role in user.roles %}
                            {% set label = role|replace({'ROLE_':'', '_':' '})|lower|title %}
                            <span class="badge bg-dark">{{ label }}</span>
                        {% else %}
                            <span class="badge bg-secondary">Aucun</span>
                        {% endfor %}
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a href="{{ path('admin_user_show', {id: user.id}) }}" class="btn btn-outline-dark btn-sm">
                                Voir
                            </a>
                            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-dark btn-sm">
                                Modifier
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">
                        {% include 'components/_empty_state.html.twig' with {message: 'Aucun utilisateur.'} %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
