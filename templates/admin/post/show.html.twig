{# J'ai cree le template pour afficher un article admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ post.title }}{% endblock %}

{% block admin_content %}
{% set actions %}
    {% if is_granted('POST_EDIT', post) %}
        <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="btn btn-dark btn-sm">Modifier</a>
    {% endif %}
{% endset %}

{% include 'components/_page_header.html.twig' with {
    title: post.title,
    subtitle: 'Slug : ' ~ post.slug,
    back_route: 'admin_post_index',
    back_label: 'Retour à la liste',
    actions: actions
} %}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <dl class="row mb-4">
                    <dt class="col-sm-3 text-muted">ID</dt>
                    <dd class="col-sm-9">#{{ post.id }}</dd>

                    <dt class="col-sm-3 text-muted">Livre</dt>
                    <dd class="col-sm-9">{{ post.bookAuthor ?: '—' }}</dd>

                    <dt class="col-sm-3 text-muted">Catégorie</dt>
                    <dd class="col-sm-9">{{ post.category ? post.category.name : '—' }}</dd>

                    <dt class="col-sm-3 text-muted">Auteur</dt>
                    <dd class="col-sm-9">{{ post.author ? post.author.email : '—' }}</dd>

                    <dt class="col-sm-3 text-muted">Créé</dt>
                    <dd class="col-sm-9">{{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '—' }}</dd>

                    <dt class="col-sm-3 text-muted">Mis à jour</dt>
                    <dd class="col-sm-9">{{ post.updatedAt ? post.updatedAt|date('d/m/Y H:i') : '—' }}</dd>
                </dl>

                <hr>

                <h2 class="h6 mb-3">Contenu</h2>
                <div class="content">{{ post.content|raw }}</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Couverture</h2>
                {% if post.coverImage %}
                    <img src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                         alt="Couverture"
                         class="img-fluid rounded"
                         loading="lazy">
                {% else %}
                    <p class="text-muted mb-0 small">Aucune image.</p>
                {% endif %}
            </div>
        </div>

        {% if is_granted('POST_DELETE', post) %}
            {% include 'components/_danger_zone.html.twig' with {
                delete_route: 'admin_post_delete',
                delete_params: {id: post.id},
                entity_id: post.id,
                confirm_message: 'Supprimer cet article ?'
            } %}
        {% endif %}
    </div>
</div>
{% endblock %}
