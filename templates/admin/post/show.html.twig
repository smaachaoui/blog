{% extends 'admin/base.html.twig' %}

{% block title %}Article{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">{{ post.title }}</h1>
        <p class="text-muted mb-0">
            Slug : <code class="text-muted">{{ post.slug }}</code>
        </p>
    </div>

    <div class="d-grid d-sm-flex gap-2">
        <a href="{{ path('admin_post_index') }}" class="btn btn-outline-dark btn-sm">Retour à la liste</a>

        {% if is_granted('POST_EDIT', post) %}
            <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="btn btn-dark btn-sm">Éditer</a>
        {% endif %}
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <tbody>
                            <tr>
                                <th class="text-nowrap">ID</th>
                                <td>#{{ post.id }}</td>
                            </tr>
                            <tr>
                                <th class="text-nowrap">Livre</th>
                                <td>{{ post.bookAuthor ?: '—' }}</td>
                            </tr>
                            <tr>
                                <th class="text-nowrap">Catégorie</th>
                                <td>{{ post.category ? post.category.name : '—' }}</td>
                            </tr>
                            <tr>
                                <th class="text-nowrap">Auteur</th>
                                <td>{{ post.author ? post.author.email : '—' }}</td>
                            </tr>
                            <tr>
                                <th class="text-nowrap">Créé</th>
                                <td>{{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '—' }}</td>
                            </tr>
                            <tr>
                                <th class="text-nowrap">Mis à jour</th>
                                <td>{{ post.updatedAt ? post.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <hr class="my-4">

                <h2 class="h6">Contenu</h2>
                <div class="mt-2">
                    {{ post.content|raw }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Couverture</h2>

                {% if post.coverImage %}
                    <img
                        src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                        alt="Couverture"
                        class="img-fluid rounded border"
                        loading="lazy"
                    >
                {% else %}
                    <div class="text-muted small">Aucune image.</div>
                {% endif %}
            </div>
        </div>

        {% if is_granted('POST_DELETE', post) %}
            <div class="card border-danger shadow-sm mt-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-danger mb-2">Zone dangereuse</h2>
                    <p class="text-muted small mb-3">La suppression est définitive.</p>

                    {{ include('post/_delete_form.html.twig', { post: post, delete_route: 'admin_post_delete' }) }}
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
