{# J'ai cree la liste des articles admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Articles{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: 'Articles',
    subtitle: 'Gestion des articles du blog.',
    actions: '<a href="' ~ path('admin_post_new') ~ '" class="btn btn-dark btn-sm">Nouvel article</a>'
} %}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Article</th>
                    <th class="d-none d-md-table-cell" style="width: 150px;">Catégorie</th>
                    <th class="d-none d-lg-table-cell" style="width: 180px;">Auteur</th>
                    <th class="d-none d-xl-table-cell" style="width: 180px;">Date</th>
                    <th class="text-end" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for post in posts %}
                <tr>
                    <td>
                        <span class="badge bg-dark">#{{ post.id }}</span>
                    </td>
                    <td>
                        <div class="d-flex gap-3 align-items-center">
                            {% if post.coverImage %}
                                <img src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                                     alt=""
                                     class="rounded d-none d-sm-block"
                                     style="width: 48px; height: 48px; object-fit: cover;"
                                     loading="lazy">
                            {% endif %}
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">{{ post.title }}</div>
                                {% if post.bookAuthor %}
                                    <small class="text-muted">{{ post.bookAuthor }}</small>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="d-none d-md-table-cell">
                        {% if post.category %}
                            <span class="badge bg-light text-dark border">{{ post.category.name }}</span>
                        {% endif %}
                    </td>
                    <td class="d-none d-lg-table-cell text-muted small">
                        {{ post.author ? post.author.email : '' }}
                    </td>
                    <td class="d-none d-xl-table-cell text-muted small">
                        {{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '' }}
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                            <a href="{{ path('admin_post_show', {id: post.id}) }}" class="btn btn-outline-dark btn-sm">
                                Voir
                            </a>
                            {% if is_granted('POST_EDIT', post) %}
                                <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="btn btn-dark btn-sm">
                                    Modifier
                                </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">
                        {% include 'components/_empty_state.html.twig' with {message: 'Aucun article.'} %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
