{# J'ai cree le template de base pour les formulaires article admin #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ page_title|default('Article') }}{% endblock %}

{% block admin_content %}
{% include 'components/_page_header.html.twig' with {
    title: heading|default(page_title|default('Article')),
    subtitle: subtitle|default('Gérer le contenu de l\'article.'),
    back_route: 'admin_post_index',
    back_label: 'Retour à la liste'
} %}

{% include 'form/_post.html.twig' with {
    form: form,
    post: post|default(null),
    title: heading|default('Article'),
    button_label: button_label|default('Enregistrer'),
    cancel_route: 'admin_post_index'
} %}

{% if show_delete|default(false) and post is defined %}
    <div class="row mt-4">
        <div class="col-12 col-lg-4 ms-auto">
            {% include 'components/_danger_zone.html.twig' with {
                delete_route: 'admin_post_delete',
                delete_params: {id: post.id},
                entity_id: post.id,
                confirm_message: 'Supprimer cet article ?'
            } %}
        </div>
    </div>
{% endif %}
{% endblock %}
