{% extends 'admin/base.html.twig' %}

{% block title %}{{ page_title|default('Article') }}{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">{{ heading|default(page_title|default('Article')) }}</h1>
        <p class="text-muted mb-0">{{ subtitle|default('Rédiger et publier un article.') }}</p>
    </div>

    <a class="btn btn-outline-dark btn-sm" href="{{ path('admin_post_index') }}">
        Retour à la liste
    </a>
</div>

{{ include('post/_form.html.twig', {
    form: form,
    post: post,
    title: heading|default('Article'),
    button_label: button_label|default('Enregistrer'),
    cancel_route: 'admin_post_index'
}) }}

{% if show_delete|default(false) %}
    <div class="row mt-3">
        <div class="col-12 col-lg-4 ms-auto">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h6 text-danger mb-2">Zone dangereuse</h2>
                    <p class="text-muted small mb-3">La suppression est définitive.</p>

                    {{ include('post/_delete_form.html.twig', { post: post, delete_route: 'admin_post_delete' }) }}
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
