{% extends 'admin/base.html.twig' %}

{% block title %}Nouvel article{% endblock %}

{% block admin_content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Créer un article</h1>
        <div class="text-muted small">Renseigne les informations de l’article puis enregistre.</div>
    </div>

    <a href="{{ path('admin_post_index') }}" class="btn btn-outline-dark">
        Retour à la liste
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        {{ include('post/_form.html.twig', {button_label: 'Créer', cancel_path: path('admin_post_index')}) }}
    </div>
</div>
{% endblock %}
