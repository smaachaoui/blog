{# J'ai cree la page d'inscription #}
{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="mb-4">
                    <h1 class="h4 mb-1">Créer un compte</h1>
                    <p class="text-muted small mb-0">Créez votre compte pour publier et gérer vos articles.</p>
                </div>

                {{ form_start(registrationForm) }}
                    <div class="mb-3">
                        {{ form_row(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(registrationForm.plainPassword, {label: 'Mot de passe'}) }}
                        <div class="form-text">8 caractères minimum.</div>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">Créer mon compte</button>
                {{ form_end(registrationForm) }}

                <hr class="my-4">

                <p class="text-center small mb-0">
                    Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
