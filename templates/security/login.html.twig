{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow-sm">
            <div class="card-body p-3 p-md-4 p-lg-5">
                <div class="mb-4">
                    <h1 class="h4 mb-1">Se connecter</h1>
                    <div class="text-muted small">Accédez à votre espace pour gérer vos articles.</div>
                </div>

                {% if error %}
                    <div class="alert alert-danger shadow-sm">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info shadow-sm">
                        Vous êtes déjà connecté en tant que <strong>{{ app.user.email }}</strong>.
                        <a href="{{ path('app_logout') }}" class="alert-link">Se déconnecter</a>
                    </div>
                {% endif %}

                <form method="post" class="vstack gap-3">
                    <div>
                        <label for="inputEmail" class="form-label">Email</label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="email"
                            id="inputEmail"
                            class="form-control"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </div>

                    <div>
                        <label for="inputPassword" class="form-label">Mot de passe</label>
                        <input
                            type="password"
                            name="password"
                            id="inputPassword"
                            class="form-control"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center gap-2">
                        <div class="form-check m-0">
                            <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                        </div>

                        {# Optionnel : à activer quand tu auras la fonctionnalité #}
                        {# <a class="small text-muted text-decoration-none" href="#">Mot de passe oublié ?</a> #}
                    </div>

                    <button class="btn btn-dark w-100" type="submit">Connexion</button>
                </form>

                <hr class="my-4">

                <div class="text-center small">
                    Pas de compte ?
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
