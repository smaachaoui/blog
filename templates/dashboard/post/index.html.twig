{# J'ai cree la liste des articles du dashboard utilisateur #}
{% extends 'dashboard/base.html.twig' %}

{% block dashboard_title %}Mes articles{% endblock %}

{% block dashboard_content %}
{% include 'components/_page_header.html.twig' with {
    title: 'Mes articles',
    subtitle: 'Gérer tes publications.',
    actions: '<a href="' ~ path('dashboard_post_new') ~ '" class="btn btn-dark btn-sm">Nouvel article</a>'
} %}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Titre</th>
                    <th class="d-none d-md-table-cell">Catégorie</th>
                    <th class="d-none d-sm-table-cell" style="width: 120px;">Date</th>
                    <th class="text-end" style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for post in posts %}
                <tr>
                    <td class="fw-semibold">{{ post.title }}</td>
                    <td class="d-none d-md-table-cell text-muted">{{ post.category.name }}</td>
                    <td class="d-none d-sm-table-cell text-muted small">{{ post.createdAt|date('d/m/Y') }}</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                            <a href="{{ path('blog_show', {slug: post.slug}) }}" class="btn btn-outline-dark btn-sm">
                                Voir
                            </a>
                            <a href="{{ path('dashboard_post_edit', {id: post.id}) }}" class="btn btn-dark btn-sm">
                                Modifier
                            </a>
                            <form method="post"
                                  action="{{ path('dashboard_post_delete', {id: post.id}) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Supprimer cet article ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button class="btn btn-outline-danger btn-sm">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">
                        {% include 'components/_empty_state.html.twig' with {message: 'Aucun article.'} %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
