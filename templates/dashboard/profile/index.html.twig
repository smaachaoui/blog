{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Mon profil</h1>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8 mb-2">{{ app.user.email }}</dd>

                </dl>

                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('dashboard_post_index') }}" class="btn btn-outline-dark">
                        Mes articles
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_dashboard') }}" class="btn btn-dark">
                            Administration
                        </a>
                    {% endif %}

                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger ms-auto">
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
