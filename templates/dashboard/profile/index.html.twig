{% extends 'dashboard/base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block dashboard_content %}
<div class="card shadow-sm">
    <div class="card-body p-3 p-md-4 p-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h4 mb-1">Informations personnelles</h1>
                <div class="text-muted small">Consultez les informations liées à votre compte.</div>
            </div>

            <div class="d-grid d-md-flex gap-2">
                <a href="{{ path('dashboard_post_index') }}" class="btn btn-outline-dark btn-sm">
                    Mes articles
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-dark btn-sm">
                        Administration
                    </a>
                {% endif %}

                <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">
                    Déconnexion
                </a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted small mb-1">Email</div>
                    <div class="fw-semibold text-break">{{ app.user.email }}</div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted small mb-1">Rôles</div>
                    <div class="fw-semibold">
                        {% set roles = app.user.roles|map(r => r|replace({'ROLE_':'', '_':' '})|lower|title) %}
                        {{ roles|join(', ') }}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
