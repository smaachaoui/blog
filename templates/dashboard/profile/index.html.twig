{# J'ai cree le template profil du dashboard utilisateur #}
{% extends 'dashboard/base.html.twig' %}

{% block dashboard_title %}Mon profil{% endblock %}

{% block dashboard_content %}
{% set actions %}
    <a href="{{ path('dashboard_post_index') }}" class="btn btn-outline-dark btn-sm">Mes articles</a>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('admin_dashboard') }}" class="btn btn-dark btn-sm">Administration</a>
    {% endif %}
{% endset %}

{% include 'components/_page_header.html.twig' with {
    title: 'Mon profil',
    subtitle: 'Informations de ton compte.',
    actions: actions
} %}

<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h6 text-muted mb-2">Email</h2>
                <div class="fw-semibold text-break">{{ app.user.email }}</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h6 text-muted mb-2">Rôles</h2>
                <div class="fw-semibold">
                    {% set roles = app.user.roles|map(r => r|replace({'ROLE_':'', '_':' '})|lower|title) %}
                    {{ roles|join(', ') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
