<div class="card shadow-sm overflow-hidden">
    <div class="card-body p-3 bg-dark text-white">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <div>
                <div class="fw-semibold">Mon espace</div>
                <div class="small text-white-50 text-truncate" style="max-width: 220px;">
                    {{ app.user.email }}
                </div>
            </div>

            <button class="btn btn-outline-light btn-sm d-md-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#dashboardMenu"
                    aria-expanded="false"
                    aria-controls="dashboardMenu">
                Menu
            </button>
        </div>
    </div>

    <div id="dashboardMenu" class="collapse d-md-block">
        <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') == 'app_profile' ? 'active' : '' }}"
               href="{{ path('app_profile') }}">
                Informations personnelles
            </a>

            <a class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'dashboard_post_' ? 'active' : '' }}"
               href="{{ path('dashboard_post_index') }}">
                Mes articles
            </a>

            <a class="list-group-item list-group-item-action text-danger"
               href="{{ path('app_logout') }}">
                Se déconnecter
            </a>
        </div>
    </div>
</div>
