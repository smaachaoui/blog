{% for label, messages in app.flashes %}
    {% set bootstrapLabel = {
        'error': 'danger',
        'success': 'success',
        'warning': 'warning',
        'info': 'info'
    }[label]|default('secondary') %}

    {% for message in messages %}
        <div class="alert alert-{{ bootstrapLabel }} alert-dismissible fade show shadow-sm mb-3"
             role="alert">
            {{ message }}

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fermer">
            </button>
        </div>
    {% endfor %}
{% endfor %}
