{# J'ai defini l'affichage des messages flash #}

{% for label, messages in app.flashes %}
    {% set alert_class = {
        'error': 'danger',
        'success': 'success',
        'warning': 'warning',
        'info': 'info'
    }[label]|default('secondary') %}

    {% for message in messages %}
        <div class="alert alert-{{ alert_class }} alert-dismissible fade show shadow-sm mb-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}
{% endfor %}
