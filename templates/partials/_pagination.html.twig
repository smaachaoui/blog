{# J'ai defini le composant de pagination #}
{# Parametres: route, currentPage, totalPages, params #}

{% if totalPages > 1 %}
    {% set window = 2 %}
    {% set start = max(1, currentPage - window) %}
    {% set end = min(totalPages, currentPage + window) %}

    <nav class="mt-4" aria-label="Pagination">
        <ul class="pagination justify-content-center flex-wrap gap-1 mb-0">
            <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                <a class="page-link text-dark"
                   href="{{ path(route, params|merge({page: currentPage - 1})) }}"
                   aria-label="Précédent">
                    <span class="d-none d-sm-inline">Précédent</span>
                    <span class="d-sm-none">‹</span>
                </a>
            </li>

            {% if start > 1 %}
                <li class="page-item">
                    <a class="page-link text-dark" href="{{ path(route, params|merge({page: 1})) }}">1</a>
                </li>
                {% if start > 2 %}
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                {% endif %}
            {% endif %}

            {% for p in start..end %}
                <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                    <a class="page-link {{ p == currentPage ? 'bg-dark border-dark text-white' : 'text-dark' }}"
                       href="{{ path(route, params|merge({page: p})) }}"
                       {% if p == currentPage %}aria-current="page"{% endif %}>
                        {{ p }}
                    </a>
                </li>
            {% endfor %}

            {% if end < totalPages %}
                {% if end < totalPages - 1 %}
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                {% endif %}
                <li class="page-item">
                    <a class="page-link text-dark" href="{{ path(route, params|merge({page: totalPages})) }}">
                        {{ totalPages }}
                    </a>
                </li>
            {% endif %}

            <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                <a class="page-link text-dark"
                   href="{{ path(route, params|merge({page: currentPage + 1})) }}"
                   aria-label="Suivant">
                    <span class="d-none d-sm-inline">Suivant</span>
                    <span class="d-sm-none">›</span>
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
