{% extends 'base.html.twig' %}

{# Generic 2-column layout with a sidebar (Admin/Dashboard) #}
{% block body %}
<div class="container-fluid py-4">
    <div class="row g-3">
        <aside class="col-12 col-lg-3 col-xl-2">
            {% block sidebar %}{% endblock %}
        </aside>

        <section class="col-12 col-lg-9 col-xl-10">            {% block content %}{% endblock %}
        </section>
    </div>
</div>
{% endblock %}
