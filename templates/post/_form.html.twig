{# Shared Post form (Admin/Dashboard) #}
{% set cancel_route = cancel_route|default('admin_post_index') %}
{% set cancel_params = cancel_params|default({}) %}

{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

<div class="row g-4 align-items-start">

    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-3">
                    <div>
                        <h1 class="h5 mb-1">{{ title|default('Article') }}</h1>
                        <div class="text-muted small">
                            Renseigne le contenu et les informations principales de l’article.
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.title) }}
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        {{ form_row(form.bookAuthor) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_row(form.category) }}
                    </div>
                </div>

                {% if form.slug is defined %}
                    <div class="mt-3">
                        {{ form_row(form.slug) }}
                        <div class="form-text">
                            Laisse vide si le slug est généré automatiquement.
                        </div>
                    </div>
                {% else %}
                    <div class="mt-3">
                        <div class="form-text">
                            L’URL de ton article est générée automatiquement à partir du titre.
                        </div>
                    </div>
                {% endif %}

                <hr class="my-4">

                <div class="mb-0">
                    {{ form_row(form.content) }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-4">
                <h2 class="h6 mb-3">Couverture</h2>

                {% if form.coverImageFile is defined %}
                    {{ form_row(form.coverImageFile) }}
                {% elseif form.coverImage is defined %}
                    {{ form_row(form.coverImage) }}
                {% else %}
                    <div class="text-muted small">
                        Aucun champ d’upload détecté dans le formulaire.
                    </div>
                {% endif %}

                {% if post is defined and post.coverImage %}
                    <div class="mt-3">
                        <div class="text-muted small mb-2">Image actuelle</div>
                        <img
                            src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                            alt="Couverture"
                            class="img-fluid rounded border"
                            loading="lazy"
                        >
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="d-grid gap-2 mt-3">
            <button class="btn btn-dark">
                {{ button_label|default('Enregistrer') }}
            </button>

            <a href="{{ path(cancel_route, cancel_params) }}" class="btn btn-outline-dark">
                Annuler
            </a>
        </div>

        <div class="alert alert-light border mt-3 mb-0 small">
            Astuce : ajoute une couverture pour améliorer le rendu sur la page d’accueil.
        </div>
    </div>

</div>

{{ form_end(form) }}
