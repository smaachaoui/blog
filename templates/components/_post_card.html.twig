{# J'ai cree un composant pour afficher une carte article #}
{# Parametres: post, show_category, show_cover #}

<article class="card shadow-sm h-100">
    <div class="card-body p-3 p-lg-4 d-flex flex-column">
        {% if show_cover|default(true) and post.coverImage %}
            <div class="ratio ratio-16x9 rounded overflow-hidden mb-3">
                <img src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                     alt="Couverture"
                     class="w-100 h-100 object-fit-cover"
                     loading="lazy">
            </div>
        {% endif %}

        <h2 class="h6 mb-1">
            <a class="text-decoration-none text-dark stretched-link"
               href="{{ path('blog_show', {slug: post.slug}) }}">
                {{ post.title }}
            </a>
        </h2>

        <div class="text-muted small">
            {% if post.bookAuthor %}{{ post.bookAuthor }} · {% endif %}
            {% if show_category|default(true) and post.category %}
                <a class="text-decoration-none text-muted"
                   href="{{ path('category_show', {slug: post.category.slug}) }}">
                    {{ post.category.name }}
                </a> ·
            {% endif %}
            {{ post.createdAt|date('d/m/Y') }}
        </div>
    </div>
</article>
