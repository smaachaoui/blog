{# J'ai cree un composant pour afficher un etat vide #}
{# Parametres: message, icon #}

<div class="text-center text-muted py-5">
    {% if icon is defined %}
        <div class="mb-3">{{ icon|raw }}</div>
    {% endif %}
    <p class="mb-0">{{ message|default('Aucun élément trouvé.') }}</p>
</div>
