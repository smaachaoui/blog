{# J'ai cree la page d'accueil #}
{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
{% include 'components/_page_header.html.twig' with {
    title: 'Derniers articles',
    subtitle: 'Les dernières critiques publiées.',
    actions: '<a href="' ~ path('blog_index') ~ '" class="btn btn-dark btn-sm">Tous les articles</a>'
} %}

<div class="row g-3 g-lg-4">
    {% for post in posts %}
        <div class="col-12 col-md-6 col-xl-4">
            {% include 'components/_post_card.html.twig' with {post: post, show_cover: false} %}
        </div>
    {% else %}
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-muted">
                    Aucun article pour le moment.
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
