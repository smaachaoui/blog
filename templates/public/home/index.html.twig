{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

<div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">Derniers articles</h1>
        <div class="text-muted small">Les dernières critiques publiées.</div>
    </div>

    <a class="btn btn-dark btn-sm" href="{{ path('blog_index') }}">Voir tous les articles</a>
</div>

<div class="row g-3 g-lg-4">
    {% for post in posts %}
        <div class="col-12 col-md-6 col-xl-4">
            <article class="card shadow-sm h-100">
                <div class="card-body p-3 p-lg-4">
                    <h2 class="h6 mb-1">
                        <a class="text-decoration-none text-dark" href="{{ path('blog_show', {slug: post.slug}) }}">
                            {{ post.title }}
                        </a>
                    </h2>
                    <div class="text-muted small">
                        {{ post.bookAuthor }} · {{ post.createdAt|date('d/m/Y') }}
                    </div>
                </div>
            </article>
        </div>
    {% else %}
        <div class="col-12 text-muted">Aucun article pour le moment.</div>
    {% endfor %}
</div>

{% endblock %}
