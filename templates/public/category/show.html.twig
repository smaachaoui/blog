{# J'ai cree la page de detail d'une categorie #}
{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
{% include 'components/_page_header.html.twig' with {
    title: category.name,
    subtitle: 'Articles de la catégorie.',
    back_route: 'category_index',
    back_label: 'Toutes les catégories'
} %}

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-12 col-md">
            <input type="text"
                   name="q"
                   class="form-control"
                   placeholder="Rechercher dans cette catégorie..."
                   value="{{ query|default('') }}">
        </div>
        <div class="col-12 col-md-auto d-grid d-md-flex gap-2">
            <button class="btn btn-dark">Rechercher</button>
            {% if query %}
                <a href="{{ path('category_show', {slug: category.slug}) }}" class="btn btn-outline-dark">Réinitialiser</a>
            {% endif %}
        </div>
    </div>
</form>

<div class="row g-3 g-lg-4">
    {% for post in posts %}
        <div class="col-12 col-md-6 col-xl-4">
            {% include 'components/_post_card.html.twig' with {post: post, show_category: false} %}
        </div>
    {% else %}
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-muted">
                    Aucun article dans cette catégorie.
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{% include 'partials/_pagination.html.twig' with {
    route: 'category_show',
    currentPage: currentPage,
    totalPages: totalPages,
    params: {slug: category.slug, q: query|default('')}
} %}
{% endblock %}
