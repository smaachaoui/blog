{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">{{ category.name }}</h1>
    <a class="btn btn-outline-dark btn-sm" href="{{ path('category_index') }}">Toutes les catégories</a>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input
                type="text"
                name="q"
                class="form-control"
                placeholder="Rechercher dans cette catégorie…"
                value="{{ query }}"
            >
            <button class="btn btn-dark">Rechercher</button>
        </div>
    </form>

</div>

<div class="row g-3">
    {% for post in posts %}
        <div class="col-12 col-md-6">
            <div class="card shadow-sm page-card h-100">
                <div class="card-body p-4">
                    {% if post.coverImage %}
                        <img src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                             alt="Couverture"
                             class="img-fluid rounded mb-3"
                             loading="lazy">
                    {% endif %}

                    <h2 class="h5 mb-1">
                        <a class="text-decoration-none text-dark" href="{{ path('blog_show', {slug: post.slug}) }}">
                            {{ post.title }}
                        </a>
                    </h2>

                    <div class="text-muted small">
                        {{ post.bookAuthor }} · {{ post.createdAt|date('d/m/Y') }}
                    </div>

                    <div class="mt-3">
                        <a href="{{ path('blog_show', {slug: post.slug}) }}" class="btn btn-outline-dark btn-sm">
                            Lire
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-muted">Aucun article dans cette catégorie.</div>
        </div>
    {% endfor %}
</div>

    {% include 'partials/_pagination.html.twig' with {
        route: 'category_show',
        currentPage: currentPage,
        totalPages: totalPages,
        params: { slug: category.slug, q: query }
    } %}

{% endblock %}
