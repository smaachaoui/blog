{# J'ai cree la liste des categories publiques #}
{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
{% include 'components/_page_header.html.twig' with {
    title: 'Catégories',
    subtitle: 'Parcourez les genres et découvrez les articles associés.',
    actions: '<a href="' ~ path('blog_index') ~ '" class="btn btn-outline-dark btn-sm">Tous les articles</a>'
} %}

<div class="row g-3 g-lg-4">
    {% for category in categories %}
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <a href="{{ path('category_show', {slug: category.slug}) }}" class="text-decoration-none">
                <div class="card shadow-sm h-100 transition-shadow">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h2 class="h6 text-dark mb-0">{{ category.name }}</h2>
                            <span class="badge bg-dark">Genre</span>
                        </div>
                        <p class="text-muted small mb-3">Voir les articles de cette catégorie</p>
                        <span class="btn btn-outline-dark btn-sm">Explorer</span>
                    </div>
                </div>
            </a>
        </div>
    {% else %}
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-muted">
                    Aucune catégorie.
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
