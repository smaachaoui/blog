{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}

<div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">Catégories</h1>
        <div class="text-muted small">Parcourez les genres et découvrez les articles associés.</div>
    </div>

    <a class="btn btn-outline-dark btn-sm" href="{{ path('app_home') }}">Voir tous les articles</a>
</div>

<div class="row g-3 g-lg-4">
    {% for category in categories %}
        <div class="col-12 col-md-6 col-xl-4 col-xxl-3">
            <a href="{{ path('category_show', {slug: category.slug}) }}" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-3 p-lg-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="h6 text-dark mb-0">{{ category.name }}</div>
                                <span class="badge text-bg-dark">Genre</span>
                            </div>
                            <div class="text-muted small mt-2">
                                Voir les articles de cette catégorie
                            </div>
                        </div>

                        <div class="mt-3">
                            <span class="btn btn-outline-dark btn-sm">Explorer</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    {% else %}
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-muted">
                    Aucune catégorie.
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{% endblock %}
