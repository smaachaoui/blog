{# J'ai cree la liste des articles du blog #}
{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
{% include 'components/_page_header.html.twig' with {
    title: 'Articles',
    subtitle: 'Découvrez les dernières critiques publiées.'
} %}

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-12 col-md">
            <input type="text"
                   name="q"
                   class="form-control"
                   placeholder="Rechercher un article..."
                   value="{{ query|default('') }}">
        </div>
        <div class="col-12 col-md-auto d-grid d-md-flex gap-2">
            <button class="btn btn-dark">Rechercher</button>
            {% if query %}
                <a href="{{ path('blog_index') }}" class="btn btn-outline-dark">Réinitialiser</a>
            {% endif %}
        </div>
    </div>
</form>

<div class="row g-3 g-lg-4">
    {% for post in posts %}
        <div class="col-12 col-md-6 col-xl-4">
            {% include 'components/_post_card.html.twig' with {post: post} %}
        </div>
    {% else %}
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-muted">
                    Aucun article trouvé.
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{% include 'partials/_pagination.html.twig' with {
    route: 'blog_index',
    currentPage: currentPage,
    totalPages: totalPages,
    params: {q: query|default('')}
} %}
{% endblock %}
