{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}

    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="q" class="form-control" placeholder="Rechercher un article…" value="{{ query|default('') }}">
            <button class="btn btn-dark">Rechercher</button>
            {% if query %}
                <a class="btn btn-outline-dark" href="{{ path('app_home') }}">Réinitialiser</a>
            {% endif %}
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Derniers articles</h1>
    </div>

    <div class="row g-3">
        {% for post in posts %}
            <div class="col-12 col-md-6">
                <div class="card shadow-sm page-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            {% if post.coverImage %}
                                <img src="{{ asset('uploads/covers/' ~ post.coverImage) }}" alt="Couverture" class="img-fluid rounded mb-3" loading="lazy">
                            {% endif %}
                            <div>
                                <h2 class="h5 mb-1">
                                    <a class="text-decoration-none text-dark" href="{{ path('blog_show', {slug: post.slug}) }}">
                                        {{ post.title }}
                                    </a>
                                </h2>
                                <div class="text-muted small">
                                    {{ post.bookAuthor }}
                                    · <a class="text-decoration-none text-muted" href="{{ path('category_show', {slug: post.category.slug}) }}">{{ post.category.name }}</a>
                                    · {{ post.createdAt|date('d/m/Y') }}
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <a href="{{ path('blog_show', {slug: post.slug}) }}" class="btn btn-outline-dark btn-sm">
                                Lire
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-muted">Aucun article pour le moment.</div>
            </div>
        {% endfor %}
    </div>

    {% include 'partials/_pagination.html.twig' with {
        route: 'app_home',
        currentPage: currentPage,
        totalPages: totalPages,
        params: { q: query }
    } %}



{% endblock %}
