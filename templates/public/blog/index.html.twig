{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-3 mb-4">
    <div>
        <h1 class="h4 mb-1">Derniers articles</h1>
        <div class="text-muted small">Découvrez les dernières critiques publiées.</div>
    </div>
</div>

<form method="get" class="mb-4">
    <div class="row g-2 align-items-stretch">
        <div class="col-12 col-md">
            <input
                type="text"
                name="q"
                class="form-control h-100"
                placeholder="Rechercher un article…"
                value="{{ query|default('') }}"
            >
        </div>

        <div class="col-12 col-md-auto d-grid d-md-flex gap-2">
            <button class="btn btn-dark">Rechercher</button>

            {% if query %}
                <a class="btn btn-outline-dark" href="{{ path('app_home') }}">Réinitialiser</a>
            {% endif %}
        </div>
    </div>
</form>

<div class="row g-3 g-lg-4">
    {% for post in posts %}
        <div class="col-12 col-md-6 col-xl-4">
            <article class="card shadow-sm h-100">
                <div class="card-body p-3 p-lg-4 d-flex flex-column">
                    <div class="row g-3">
                        {% if post.coverImage %}
                            <div class="col-12 col-sm-4">
                                <div class="ratio ratio-1x1 rounded overflow-hidden shadow-sm">
                                    <img
                                        src="{{ asset('uploads/covers/' ~ post.coverImage) }}"
                                        alt="Couverture"
                                        class="w-100 h-100"
                                        style="object-fit: cover;"
                                        loading="lazy"
                                    >
                                </div>
                            </div>
                        {% endif %}

                        <div class="col">
                            <h2 class="h6 h5-lg mb-1">
                                <a class="text-decoration-none text-dark"
                                   href="{{ path('blog_show', {slug: post.slug}) }}">
                                    {{ post.title }}
                                </a>
                            </h2>

                            <div class="text-muted small">
                                {{ post.bookAuthor }}
                                · <a class="text-decoration-none text-muted"
                                     href="{{ path('category_show', {slug: post.category.slug}) }}">
                                    {{ post.category.name }}
                                </a>
                                · {{ post.createdAt|date('d/m/Y') }}
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 mt-lg-4 d-flex gap-2">
                        <a href="{{ path('blog_show', {slug: post.slug}) }}" class="btn btn-outline-dark btn-sm">
                            Lire
                        </a>
                    </div>
                </div>
            </article>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-muted">Aucun article pour le moment.</div>
        </div>
    {% endfor %}
</div>

<div class="mt-4">
    {% include 'partials/_pagination.html.twig' with {
        route: 'app_home',
        currentPage: currentPage,
        totalPages: totalPages,
        params: { q: query }
    } %}
</div>

{% endblock %}
